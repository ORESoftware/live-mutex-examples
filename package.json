{
  "name": "live-mutex-examples",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable TypeScript examples and contract tests for live-mutex.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/live-mutex.test.js",
    "example:async": "npm run build && node dist/examples/async-await.js",
    "example:promises": "npm run build && node dist/examples/promises.js",
    "example:ttl": "npm run build && node dist/examples/ttl-timeout.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ORESoftware/live-mutex-examples.git"
  },
  "keywords": [
    "live-mutex",
    "mutex",
    "fencing-token",
    "typescript",
    "examples"
  ],
  "author": "ORESoftware",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ORESoftware/live-mutex-examples/issues"
  },
  "homepage": "https://github.com/ORESoftware/live-mutex-examples#readme",
  "dependencies": {
    "live-mutex": "0.2.27"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
